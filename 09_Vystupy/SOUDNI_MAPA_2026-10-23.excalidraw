   "locked": false,
   "version": 1,
   "versionNonce": 873341358,
   "isDeleted": false,
   "text": "JAK MAPU ČÍST\nModrá = běží, zelená = rozhodnuto ve prospěch TJ, šedá = skončeno/zastaveno bez merita, oranžová = chybí podklad.\n\nŠipka = návaznost (odvolání, vrácení věci, podmíněnost).",
   "fontSize": 13,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "JAK MAPU ČÍST\nModrá = běží, zelená = rozhodnuto ve prospěch TJ, šedá = skončeno/zastaveno bez merita, oranžová = chybí podklad.\n\nŠipka = návaznost (odvolání, vrácení věci, podmíněnost).",
   "lineHeight": 1.25,
   "baseline": 11,
   "seed": 998388735
  },
